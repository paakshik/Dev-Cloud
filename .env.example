# Paste your PostgreSQL connection URL here; never commit this file.
# For local dev use the provider's external URL; deployed services should use private networking when available.
DATABASE_URL=
# Optional Redis cache URL (Render Key Value or local Redis). App still works without Redis.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=3
DB_CONNECT_TIMEOUT=5
SESSION_SECRET=
COOKIE_HTTPS_ONLY=false
PUBLIC_API_URL=http://127.0.0.1:8000
FRONTEND_URL=
